    "tunnel": "node server/index.js --tunnel"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@playwright/test": "^1.55.0"
  }
}
