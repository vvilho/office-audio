{
  "name": "office-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "demo": "node server/index.js --local",
    "certs": "node scripts/certs.js",
